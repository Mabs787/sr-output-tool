{
  "name": "sr-output-tool",
  "version": "1.2.1",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "description": "Screen Reader Outcome Engine — shared screen reader logic for the browser extension",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "storybook": "turbo run build --filter=@sr-output/storybook-addon... && yarn workspace storybook-app storybook",
    "build": "turbo run build",
    "build:engine": "npm run build -w packages/sr-engine",
    "build:extension-runtime": "turbo run build:runtime --filter=@sr-output/extension",
    "package:extension": "turbo run package:zip --filter=@sr-output/extension",
    "test:unit": "turbo run test:unit",
    "test-app": "node test-app/server.js",
    "voiceover:create-url-manifest": "node .github/scripts/create-voiceover-url-manifest.mjs",
    "voiceover:create-refinement-prompt": "node .github/scripts/create-refinement-prompt.mjs",
    "voiceover:import-fixtures": "node .github/scripts/import-voiceover-fixtures.mjs",
    "voiceover:preprocess-artifact": "node .github/scripts/refine-voiceover-artifact.mjs",
    "voiceover:refine-artifact": "node .github/scripts/refine-voiceover-artifact.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "turbo": "^2.0.14"
  },
  "engines": {
    "node": ">=24"
  }
}
